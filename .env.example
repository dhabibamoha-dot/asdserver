# انسخ الملف ده لاسم ".env" واملأ القيم الحقيقية بتاعتك، ومتفتحش الملف الحقيقي لأي حد.

# رابط الاتصال بـ MongoDB Atlas (مجاني). سيبه فاضي لو عايز تجرب من غير MongoDB
# حقيقي دلوقتي — السيرفر هيستخدم ملف JSON محلي بدل منه تلقائيًا.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/multi_tabs_controller

# أول أدمن بيتعمل تلقائي أول تشغيل بالبيانات دي. غيّرهم لحاجة بتاعتك.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-something-long-and-random

# البورت (أغلب الاستضافات بتحدده هي تلقائي؛ محليًا 8787 شغال كويس)
PORT=8787
